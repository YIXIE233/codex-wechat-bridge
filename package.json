{
  "name": "codex-wechat-bridge",
  "version": "0.1.0-reextract",
  "description": "Codex-only WeChat bridge extracted from CLI-WeChat-Bridge",
  "type": "module",
  "files": [
    "bin/",
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE.txt"
  ],
  "keywords": [
    "wechat",
    "codex",
    "bridge"
  ],
  "author": "UNLINEARITY",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YIXIE233/codex-wechat-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/YIXIE233/codex-wechat-bridge/issues"
  },
  "homepage": "https://github.com/YIXIE233/codex-wechat-bridge#readme",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "codex-wechat-bridge": "bin/codex-wechat-bridge.mjs",
    "codex-wechat-check-update": "bin/codex-wechat-check-update.mjs",
    "codex-wechat-daemon": "bin/codex-wechat-daemon.mjs",
    "codex-wechat-doctor": "bin/codex-wechat-doctor.mjs",
    "codex-wechat-mcp": "bin/codex-wechat-mcp.mjs",
    "codex-wechat-setup": "bin/codex-wechat-setup.mjs",
    "wechat-bridge-codex": "bin/wechat-bridge-codex.mjs",
    "wechat-codex": "bin/wechat-codex.mjs",
    "wechat-codex-start": "bin/wechat-codex-start.mjs",
    "wechat-setup": "bin/wechat-setup.mjs"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "postinstall": "node scripts/ensure-node-pty-permissions.mjs",
    "lint": "eslint bin src test",
    "lint:fix": "eslint bin src test --fix",
    "typecheck:src": "tsc -p tsconfig.typecheck.src.json --noEmit --pretty false",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "quality": "pnpm run lint && pnpm run typecheck:src && pnpm run test && pnpm run build",
    "setup": "node --no-warnings --experimental-strip-types src/wechat/setup.ts",
    "bridge": "node --no-warnings --experimental-strip-types src/bridge/wechat-bridge.ts",
    "check-update": "node --no-warnings --experimental-strip-types src/commands/check-update.ts",
    "daemon": "node --no-warnings --experimental-strip-types src/daemon/codex-daemon.ts",
    "doctor": "node --no-warnings --experimental-strip-types src/utils/doctor.ts",
    "mcp": "node --no-warnings --experimental-strip-types src/wechat/wechat-mcp.ts",
    "codex:start": "node --no-warnings --experimental-strip-types src/codex/codex-start.ts",
    "codex:panel": "node --no-warnings --experimental-strip-types src/codex/codex-remote-client.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "node-pty": "^1.1.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^24.12.4",
    "eslint": "^10.3.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=24.0.0"
  }
}
